        "type": "function",
        "z": "f1",
        "name": "function 1",
        "func": "// PESTAÑA: ON MESSAGE\n\n// 1. ASIGNACIÓN DE VARIABLES\nvar valorHumedad = msg.payload.hum;\nvar valorTemp = msg.payload.temp;\nvar nombreDispositivo = msg.payload.device;\nvar estado = msg.payload.status;\n\n// TU ID \nvar myChatId = \"pon_tu_chat_ID\"; \n\n// 2. PROTECCIÓN\nif (valorHumedad === undefined) return null;\n\n// 3. CONSTRUCCIÓN DEL MENSAJE\nmsg.payload = {\n    chatId: myChatId,\n    type: \"message\",\n    content: \"🚨 *ALERTA CRÍTICA DE INFRAESTRUCTURA* 🚨\\n\\n\" +\n             \"📡 Dispositivo: \" + nombreDispositivo + \"\\n\" +\n             \"💧 Humedad: \" + valorHumedad + \"% (Crítico)\\n\" +\n             \"🌡️ Temperatura: \" + valorTemp + \"ºC\\n\" +\n             \"ℹ️ Estado Sensor: \" + estado\n};\n\n// --- LA LÍNEA QUE FALTABA ---\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
